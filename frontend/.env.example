# Where the frontend looks for the backend API. Vite bakes this in when the dev
# server starts, so restart `npm run dev` after changing it — editing .env alone
# doesn't take effect on an already-running server.
#
# Default (this PC only):
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Accessing the app from your phone or another device (e.g. over Tailscale)?
# Point this at that address instead, e.g.:
#   VITE_API_BASE_URL=http://100.x.y.z:8000
# and start the dev servers with `.\scripts\dev.ps1 -Remote` — see the README's
# "Access it from your phone or another device" section.
