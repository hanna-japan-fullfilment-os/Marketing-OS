# Copy to .env and fill in. Never commit the real .env.

# --- OpenAI ---
OPENAI_API_KEY=
# Model names live here, never in source code. Change any of these from Settings
# in the app (which writes to the `settings` table and overrides these) without
# touching code.
OPENAI_RESEARCH_MODEL=gpt-5.1
OPENAI_CAMPAIGN_MODEL=gpt-5.1
OPENAI_VISION_MODEL=gpt-5.1
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_DRAFT_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
OPENAI_PREMIUM_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_REVISION_MODEL=gpt-image-2.5-sunburst-2026-09-08

# GPT Image 2.5 live-safety contract.
# Set the attestation to true ONLY after independently verifying the
# dedicated OpenAI project's hard spend limit.
OPENAI_PROJECT_ID=
OPENAI_PROJECT_HARD_LIMIT_ATTESTED=false
# REQUIRED before GPT Image 2.5 live generation. Choose the ceiling explicitly.
# OPENAI_MAX_IMAGE_CALLS=8

# --- Repositories (Windows paths, e.g. C:\Marketing\Source) ---
SOURCE_ASSET_ROOT=
OUTPUT_ROOT=

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- Research caching ---
TREND_RESEARCH_TTL_HOURS=24
CATEGORY_RESEARCH_TTL_HOURS=168

# --- Novelty thresholds (0-100 similarity score cutoffs) ---
NOVELTY_TOO_SIMILAR_THRESHOLD=75
NOVELTY_ACCEPTABLE_THRESHOLD=45

# --- Meta (Facebook Page / Instagram) auto-publish ---
# See the README's "Facebook Page / Instagram auto-publish" section for how to get
# these. You can also set them later from the Settings page instead of here.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Only needed for Instagram (Meta's API must fetch the image from a public URL —
# Facebook Page posts upload the file directly and don't need this). Point it at a
# public tunnel (e.g. ngrok) in front of this backend, no trailing slash.
PUBLIC_BASE_URL=

# --- Server ---
# BACKEND_HOST/BACKEND_PORT aren't read by anything (the dev.ps1 script controls
# the actual bind address/port) — kept here in case a future non-dev launcher
# wants them, not because changing them today does anything.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Every origin the frontend can legitimately be served from, comma-separated. If
# you're accessing the app from your phone or another device (e.g. over
# Tailscale — see the README's "Access it from your phone or another device"
# section), add that origin here too rather than replacing the default, e.g.:
#   CORS_ORIGINS=http://localhost:5173,http://100.x.y.z:5173
CORS_ORIGINS=http://localhost:5173
